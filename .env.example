# Knowledge Hub — environment variables
# Copy to .env.local for local development, and set the same names in Vercel → Project → Settings → Environment Variables.
# All are server-only: the browser never talks to Supabase directly, so nothing uses a NEXT_PUBLIC_ prefix.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable" key (or the legacy "anon" key) — used for the signed-in user's session
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# "Secret" key (or the legacy "service_role" key) — server actions only. Never expose or commit it.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ── Optional ──────────────────────────────────────────────────────────────────────────────────────

# Error alerts: a Slack/Teams/other webhook URL that receives a short summary of each unexpected error
# (no personal data). Errors are always logged to Vercel → Logs either way.
# ERROR_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# Encrypts agent API keys so administrators can show them again (Administration → Copilot integration).
# Any long random string. Without it, a key derived from SUPABASE_SECRET_KEY is used — rotating that secret
# then makes existing keys impossible to show again (they keep working).
# API_KEY_ENCRYPTION_KEY=change-me-to-a-long-random-string
